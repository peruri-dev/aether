# API
API_BASE_URL=http://localhost:8080
API_VERSION=v1
API_KEY=
API_TIMEOUT_MS=15000

# Auth
# jwt  = login ke backend sungguhan
# mock = login tanpa backend, untuk development dan demo
AUTH_STRATEGY=mock
# Opsional: endpoint JWKS untuk verifikasi signature JWT
AUTH_JWKS_URL=

# App
PUBLIC_BRAND=neutral
PUBLIC_APP_NAME=Dashboard

# Server Node
HOST=0.0.0.0
PORT=4321